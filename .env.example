# ── MongoDB ────────────────────────────────────────────────────────────────
# Local mongod, Docker, or MongoDB Atlas. The database is auto-seeded from
# src/data/tournament-data.ts on first request (or run: npm run seed).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=magura_golden_cup

# ── Admin portal ───────────────────────────────────────────────────────────
# Preferred: sha256 hash of the password
#   node -e "console.log(require('crypto').createHash('sha256').update('your-password').digest('hex'))"
ADMIN_PASSWORD_HASH=
# Or a plain password (fine for local use)
ADMIN_PASSWORD=magura2026

# Signs the 12-hour admin session cookie
ADMIN_SESSION_SECRET=change-this-to-a-long-random-string
